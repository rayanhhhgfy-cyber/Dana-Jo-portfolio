<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t("login_title") %> · <%= t("brand_name") %></title>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <a class="lang-switch-admin" href="/lang/<%= locale === 'ar' ? 'en' : 'ar' %>" aria-label="<%= t("lang_switch_label") %>" title="<%= t("lang_switch_label") %>" style="align-self:flex-end"><%= t("lang_other") %></a>
    <h1><%= t("login_h") %></h1>
    <p><%= t("login_p") %></p>
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>
    <form method="post" action="/admin/login">
      <div class="field">
        <label for="email"><%= t("login_email") %></label>
        <input id="email" name="email" type="email" required autocomplete="username" placeholder="you@example.com" dir="ltr" style="text-align:left">
      </div>
      <div class="field">
        <label for="password"><%= t("login_password") %></label>
        <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••" dir="ltr" style="text-align:left">
      </div>
      <button class="btn" type="submit"><%= t("login_btn") %></button>
    </form>
    <a class="back-site" href="/"><span class="arr">←</span> <%= t("login_back") %></a>
  </div>
</div>
</body>
</html>
