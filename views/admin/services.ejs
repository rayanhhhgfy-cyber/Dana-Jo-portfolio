<%- include("_top", { title: t("admin_services"), sub: t("svc_sub"), active: "services", unread }) %>
<div class="panel">
  <h2><%= editing ? t("svc_edit") : t("svc_add") %></h2>
  <form method="post" action="/admin/services">
    <% if (editing) { %><input type="hidden" name="id" value="<%= editing.id %>"><% } %>
    <%- include("_dual", { id: "s-title", label: t("svc_title"), name: "title", value: editing ? editing.title : "", valueAr: editing ? editing.title_ar : "", kind: "input", attrs: 'required maxlength="160" placeholder="' + t("ph_service_title") + '"', required: true }) %>
    <div class="field">
      <label for="s-order"><%= t("svc_sort") %></label>
      <input id="s-order" name="sort_order" type="number" value="<%= editing ? editing.sort_order : 0 %>">
    </div>
    <%- include("_dual", { id: "s-desc", label: t("svc_desc"), name: "description", value: editing ? editing.description : "", valueAr: editing ? editing.description_ar : "", kind: "textarea", attrs: 'maxlength="5000" placeholder="' + t("ph_service_desc") + '"' }) %>
    <div class="checkrow">
      <input id="s-pub" name="published" type="checkbox" value="1" <%= !editing || editing.published ? "checked" : "" %>>
      <label for="s-pub" style="margin:0"><%= t("svc_published") %></label>
    </div>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap">
      <button class="btn sage" type="submit"><%= editing ? t("svc_save") : t("svc_add_btn") %></button>
      <% if (editing) { %><a class="btn ghost" href="/admin/services"><%= t("btn_cancel") %></a><% } %>
    </div>
  </form>
</div>
<div class="panel">
  <h2><%= t("svc_all") %> (<%= services.length %>)</h2>
  <% if (services.length) { %>
    <div class="tbl-wrap"><table class="tbl">
      <thead><tr><th><%= t("th_title") %></th><th><%= t("svc_desc") %></th><th><%= t("th_status") %></th><th><%= t("th_order") %></th><th><%= t("th_actions") %></th></tr></thead>
      <tbody>
        <% services.forEach(function(s) { %>
          <tr>
            <td><b><%= L(s, "title") %></b></td>
            <td><%= L(s, "description").length > 90 ? L(s, "description").slice(0, 90) + "…" : L(s, "description") %></td>
            <td><% if (s.published) { %><span class="badge pub"><%= t("badge_published") %></span><% } else { %><span class="badge draft"><%= t("badge_draft") %></span><% } %></td>
            <td><%= s.sort_order %></td>
            <td>
              <div class="row-actions">
                <a class="btn sm ghost" href="/admin/services?edit=<%= s.id %>"><%= t("btn_edit") %></a>
                <form method="post" action="/admin/services/<%= s.id %>/toggle" style="margin:0"><button class="btn sm ghost" type="submit"><%= s.published ? t("btn_unpublish") : t("btn_publish") %></button></form>
                <form method="post" action="/admin/services/<%= s.id %>/delete" style="margin:0" onsubmit="return confirm('<%= t("confirm_delete_service") %>')"><button class="btn sm warn-ghost" type="submit"><%= t("btn_delete") %></button></form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } else { %>
    <div class="empty-admin"><%= t("svc_empty") %></div>
  <% } %>
</div>
<%- include("_bottom") %>
