<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= t("admin_title_suffix") %></title>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <div class="main">
    <div class="topbar">
      <div>
        <h1 class="page-title"><%= title %></h1>
        <% if (typeof sub !== "undefined" && sub) { %><p class="page-sub"><%= sub %></p><% } %>
      </div>
      <a class="lang-switch-admin" href="/lang/<%= locale === 'ar' ? 'en' : 'ar' %>?next=<%= encodeURIComponent(currentPath) %>" aria-label="<%= t("lang_switch_label") %>" title="<%= t("lang_switch_label") %>"><%= t("lang_other") %></a>
    </div>
    <% if (typeof toastKey !== "undefined" && toastKey) { %>
      <div class="toast toast-<%= toastType === "error" ? "error" : "ok" %>" id="toast" role="status">
        <span class="toast-ic"><%= toastType === "error" ? "!" : "✓" %></span>
        <span><%= t(toastKey) %></span>
      </div>
    <% } %>
