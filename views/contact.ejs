<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head>
<%- include("partials/head", { title: t("nav_contact") }) %>
</head>
<body>
<%- include("partials/header", { page }) %>
<main>
  <section class="section hero-pad" style="padding-bottom:clamp(2.5rem,5vw,4rem)">
    <div class="wrap">
      <span class="eyebrow reveal"><span class="num">05</span> <%= t("eyebrow_contact") %></span>
      <h1 class="display reveal" style="--d:.08s;margin-bottom:1.2rem"><%= c.contact_title %></h1>
      <p class="lede reveal" style="--d:.16s"><%= c.contact_subtitle %></p>
    </div>
  </section>
  <section style="padding-bottom:clamp(5rem,10vw,8rem)">
    <div class="wrap">
      <div class="contact-grid">
        <div class="form-card reveal" data-r="left">
          <% if (sent) { %>
            <div class="form-note ok"><b><%= t("sent_title") %></b> <%= t("sent_body") %></div>
          <% } %>
          <% if (error) { %>
            <div class="form-note err"><%= error %></div>
          <% } %>
          <form id="contactForm" method="post" action="/contact" novalidate>
            <div class="field">
              <label for="f-name"><%= t("label_name") %> <i>*</i></label>
              <input id="f-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="<%= t("ph_name") %>">
            </div>
            <div class="field">
              <label for="f-email"><%= t("label_email") %> <i>*</i></label>
              <input id="f-email" name="email" type="email" required maxlength="160" autocomplete="email" placeholder="<%= t("ph_email") %>" dir="ltr" style="text-align:left">
            </div>
            <div class="field">
              <label for="f-msg"><%= t("label_message") %> <i>*</i></label>
              <textarea id="f-msg" name="message" required maxlength="5000" placeholder="<%= t("ph_message") %>"></textarea>
            </div>
            <button class="btn btn-solid" type="submit" style="width:100%"><%= t("send_message") %> <span class="arr">→</span></button>
          </form>
        </div>
        <div class="reveal" data-r="right" style="--d:.12s">
          <h2 class="display" style="font-size:clamp(1.6rem,3.5vw,2.1rem);margin:0 0 1.4rem"><%= t("prefer_direct") %> <em><%= t("prefer_direct_em") %></em></h2>
          <a class="direct-card" href="<%= c.whatsapp_url %>" target="_blank" rel="noopener">
            <span class="ic" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.4 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.2-.7.3-.9.9-1.1 2.2-.2 3.9a11.6 11.6 0 0 0 4.5 4.2c1.7.8 2.4.9 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2 0-.1-.2-.1-.4-.2z"/></svg></span>
            <span><b>WhatsApp</b><small><%= t("wa_card_sub") %></small></span>
          </a>
          <a class="direct-card" href="<%= c.facebook_url %>" target="_blank" rel="noopener">
            <span class="ic" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V9.7c0-.9.3-1.6 1.7-1.6h1.5V5.2c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.7H7.8V15h2.7v7h3z"/></svg></span>
            <span><b>Facebook</b><small><%= t("fb_card_sub") %></small></span>
          </a>
          <div class="empty" style="margin-top:1.6rem;padding:2.2rem 1.4rem">
            <h3 style="font-size:1.25rem"><%= t("enquiry_note_title") %></h3>
            <p style="font-size:0.92rem"><%= t("enquiry_note_body") %></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
<%- include("partials/footer", { c }) %>
<script src="/js/site.js" defer></script>
</body>
</html>
